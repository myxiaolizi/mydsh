{
  "_comment": "复制为 relay.config.json 后按需修改。不要把这个文件直接用于生产：里面有需要你填的真实路径。",
  "_comment_secret": "tokenSecret 不要写在这里。请用环境变量 MYDSH_RELAY_TOKEN_SECRET 注入；留空时程序会在 dataDir 下自动生成 signing.key。",

  "listen": {
    "host": "0.0.0.0",
    "port": 8787
  },

  "tls": {
    "_comment": "宝塔上用 nginx 做 HTTPS 终止时保持 enabled=false；让 Node 自己终结 TLS 才需要填证书路径。",
    "enabled": false,
    "certPath": "/www/server/panel/vhost/cert/mydsh.zhengl.vip/fullchain.pem",
    "keyPath": "/www/server/panel/vhost/cert/mydsh.zhengl.vip/privkey.pem"
  },

  "domain": "mydsh.zhengl.vip",
  "publicUrl": "https://mydsh.zhengl.vip",

  "dataDir": "./data",
  "usersFile": "",
  "signingKeyFile": "",
  "tokenSecret": "",

  "auth": {
    "allowRegistration": true,
    "maxUsers": 50,
    "inviteCode": "",
    "tokenTtlSec": 43200,
    "cookieName": "mydsh_token",
    "cookieSecure": true,
    "requireEmailVerification": false
  },

  "limits": {
    "maxDevicesPerUser": 5,
    "loginMaxFailures": 5,
    "registerPerHour": 10,
    "upgradeAttemptsPerMinute": 30,
    "apiRequestsPerMinute": 120,
    "maxBodyBytes": 26214400,
    "maxJsonBodyBytes": 65536
  },

  "tunnel": {
    "heartbeatMs": 30000,
    "httpTimeoutMs": 60000,
    "maxChannelsPerDevice": 32,
    "maxMessageBytes": 16777216
  },

  "security": {
    "_comment": "宝塔 nginx 反代必须 trustProxy=true，否则所有请求的客户端 IP 都会是 127.0.0.1，IP 白名单和限流会集体失效。",
    "trustProxy": true,
    "visitorRequireAuth": false,
    "globalIpAllowlist": [],
    "allowedOrigins": [],
    "hsts": false
  },

  "log": {
    "level": "info"
  }
}
