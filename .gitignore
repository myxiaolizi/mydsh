# Build output.
#
# Only `lib/client.js` is generated — `scripts/build-client.mjs` bundles `src/client/`
# into it. Everything else under `lib/` (`index.js`, `host/`) is hand-written Host source
# and must be tracked: ignoring the whole directory shipped a repository whose Host half
# was missing, so a fresh clone could build the UI but none of the backend.
lib/client.js

# Dependencies.
node_modules/
# `package-lock.json` is committed on purpose. It pins the one build dependency
# (esbuild), and the lockfile was ignored while the dependency was undeclared, so a
# fresh clone ran `npm install` and got nothing, then failed to build.

# Editor and OS noise.
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Local scratch.
tmp/
*.log

# Never commit real credentials. The plugin reads them from the Host's credential store
# at runtime, and `.env.example` is the only form that belongs in the repository.
.env
.env.local
*.local.env

# Local secrets, kept out of the repository by name as well as by location. A push token
# once sat in a shell command in a session log and GitHub revoked it on detection, so the
# token lives in this directory with an ignore rule rather than in any tracked file.
secrets/
